## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
[Bb]uild/
[Ll]og/
*.log

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db

# Visual Studio Code
.vscode/

# Publish output
**/publish/

# NuGet packages
*.nupkg
packages/
*.snupkg

# Others
*.exe
*.dll
*.pdb
*.cache
*.dbmdl
*.bak
*.tmp

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt
